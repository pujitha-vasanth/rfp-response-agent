# Copy this file to .env and fill in your values.
# Never commit .env to GitHub (it is already listed in .gitignore).

# Which model provider to use: demo, azure or openai
#   demo   = runs offline with simple rules, no key needed (good for a first test)
LLM_PROVIDER=demo

# Azure OpenAI (Microsoft Foundry). Endpoint looks like https://your-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# The name you gave your model deployment in Foundry
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# OpenAI (only if you use LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional settings
COMPANY_NAME=Brightpath Digital
PASS_SCORE=4
MAX_DRAFTS=3
MAX_WORKERS=5
